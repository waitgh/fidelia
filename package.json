{
  "name": "fidelia",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Browser-only church bookkeeping: data is encrypted and decrypted in the browser and stored in the church's own cloud",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "FIDELIA_PHONE=1 vite --port 5174",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "predev": "node scripts/vendor-ocr.mjs",
    "predev:phone": "node scripts/vendor-ocr.mjs",
    "prebuild": "node scripts/vendor-ocr.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.8.1",
    "sql.js": "^1.15.2",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}

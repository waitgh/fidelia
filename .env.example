# Copy to .env.local and fill in. These are public identifiers (they ship in the JS bundle).

# Google (Drive storage, Drive picker, Gmail sending) is hidden unless this is 1. Off for now:
# Google's picker fails in Safari/iPhone/Firefox, and second treasurers need it to reach a
# shared Drive file. Dropbox is the default storage.
VITE_ENABLE_GOOGLE=

# Google OAuth client ID (type "Web application"), with this site's origin as an
# authorized JavaScript origin and "<origin>/" as an authorized redirect URI.
# Enable the Google Drive API. Scope used: drive.file
VITE_GOOGLE_CLIENT_ID=
# Optional: "Choose in Google Drive" (Google Picker). Enable the Google Picker API and create an
# API key restricted to this site (HTTP referrers) and to the Picker API. The API key must be in
# the same project as the client ID. Without it, users type a folder name instead.
VITE_GOOGLE_API_KEY=
# For Gmail sending, also add "<origin>/oauth-callback.html" as a redirect URI and
# enable the Gmail API (scope gmail.send; Google may require app verification).

# Microsoft Entra app registration, platform "Single-page application",
# redirect URI "<origin>/oauth-callback.html", supported accounts: any org + personal.
# Delegated permissions: Mail.Send, offline_access, openid, profile, email.
VITE_MS_CLIENT_ID=

# Dropbox app (the default storage): dropbox.com/developers/apps → Scoped access, Full Dropbox.
# Settings: redirect URIs "<origin>/" (e.g. https://fidelia-browser.pages.dev/ and http://localhost:5173/).
# PKCE is used, so there is no app secret in the site. Development apps allow 50 users;
# apply for production in the app console before a wide release.
# Permissions: files.metadata.read, files.content.read, files.content.write.
VITE_DROPBOX_APP_KEY=
